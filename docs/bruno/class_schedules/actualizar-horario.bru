meta {
  name: Actualizar horario
  type: http
  seq: 1
}

put {
  url: {{base_url}}/api/v1/class-schedules/{{schedule_id}}
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
{
  "class_id": 0,
  "day_of_week": 0,
  "start_time": "",
  "end_time": "",
  "room_id": 0
}
}

