meta {
  name: Renovar el token de acceso
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/refresh
  body: json
  auth: none
}
auth: none

headers {
  Content-Type: application/json
}

body:json {
{
  "refresh_token": ""
}
}

script:post-response {
  const json = res.body;
  if (json && json.access_token) {
    bru.setVar("token", json.access_token);
  }
}

