meta {
  name: Obtener token (OAuth2)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/token
  body: json
  auth: none
}
auth: none

headers {
  Content-Type: application/json
}

body:json {
{}
}

script:post-response {
  const json = res.body;
  if (json && json.access_token) {
    bru.setVar("token", json.access_token);
  }
}

