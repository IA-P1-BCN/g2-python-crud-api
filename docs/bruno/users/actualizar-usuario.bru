meta {
  name: Actualizar usuario
  type: http
  seq: 1
}

put {
  url: {{base_url}}/api/v1/users/{{user_id}}
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
{
  "email": "",
  "full_name": "",
  "role": "admin",
  "is_active": false,
  "password": ""
}
}

