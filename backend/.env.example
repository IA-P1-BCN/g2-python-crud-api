# Copy this file to .env and adjust the values. Never commit .env.

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://athletica:athletica@localhost:5432/athletica

# The schema is created by Alembic (`alembic upgrade head`). Leave this false so Alembic
# stays the single source of truth; set it to true only for a throwaway database.
AUTO_CREATE_TABLES=false

# JWT. Generate a real key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
# Rotating log file (1 MB x 5 backups). Leave empty to log only to the console.
LOG_FILE=logs/app.log
