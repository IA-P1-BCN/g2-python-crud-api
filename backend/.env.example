# Copy this file to .env and adjust the values. Never commit .env.

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://athletica:athletica@localhost:5432/athletica

# The schema is created by Alembic (`alembic upgrade head`). Leave this false so Alembic
# stays the single source of truth; set it to true only for a throwaway database.
AUTO_CREATE_TABLES=false

# JWT. Generate a real key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Login attempts allowed from one IP within the window (seconds)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Emails are not sent yet: their links are written to the backend log
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173

# Login with GitHub: register an OAuth App in GitHub (Settings > Developer settings) with this
# callback URL. Leave GITHUB_CLIENT_ID empty to turn it off.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
# Rotating log file (1 MB x 5 backups). Leave empty to log only to the console.
LOG_FILE=logs/app.log
